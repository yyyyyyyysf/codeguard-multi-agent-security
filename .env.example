# ============================================================
# CodeGuard Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
CODEGUARD_HOST=0.0.0.0
CODEGUARD_PORT=8000
CODEGUARD_LOG_LEVEL=INFO
CODEGUARD_ENV=development

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Database (SQLite for MVP) ---
DATABASE_URL=sqlite:///data/codeguard.db

# --- Storage Paths ---
REPO_WORK_DIR=/tmp/codeguard_repos
REPORT_STORAGE_DIR=/tmp/codeguard_reports
CVE_CACHE_DB_PATH=data/cve_cache.db
# LangGraph checkpoint DB for human-in-the-loop pause/resume.
CODEGUARD_CHECKPOINT_DB_PATH=data/checkpoint.db

# --- GitHub Integration ---
GITHUB_TOKEN=
# v0.1+: mandatory. HMAC-SHA256 secret from your GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# --- GitLab Integration (v0.2+) ---
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# --- LLM Configuration (for Migration Agent) ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-coder
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30

# --- OSV API ---
OSV_API_BASE_URL=https://api.osv.dev/v1
OSV_API_TIMEOUT_SECONDS=10

# --- GitHub Advisory Database ---
GITHUB_ADVISORY_TOKEN=

# --- Security ---
# v0.1+: mandatory. Static API key for API auth. Requests without it get 401.
CODEGUARD_API_KEY=
# Comma-separated list of allowed repo clone hosts (SSRF prevention).
CODEGUARD_ALLOWED_REPO_HOSTS=github.com,gitlab.com
WEBHOOK_CALLBACK_PRE_SHARED_KEY=
BLOCK_SEVERITY_THRESHOLD=high
HUMAN_LOOP_TIMEOUT_HOURS=24

# --- Rate Limiting (MVP reserved) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
